{
  "version": "2026.08.1",
  "rules": [
    {
      "id": "block-sensitive-from-public",
      "effect": "deny",
      "resources": ["*"],
      "min_sensitivity": 3,
      "when": { "networks": ["public"] }
    },
    {
      "id": "crown-jewels-hardware-key",
      "effect": "allow",
      "resources": ["signing-service"],
      "when": {
        "min_auth": "hardware-key",
        "managed_device": true,
        "patched_device": true,
        "disk_encryption": true,
        "roles": ["release-eng"],
        "networks": ["corp"]
      },
      "obligations": {
        "reauth_within_seconds": 300,
        "session_ttl_seconds": 900
      }
    },
    {
      "id": "sensitive-needs-mfa-managed",
      "effect": "allow",
      "resources": ["payroll-db", "customer-pii"],
      "when": {
        "min_auth": "mfa",
        "managed_device": true,
        "patched_device": true,
        "networks": ["corp", "vpn"]
      },
      "obligations": {
        "session_ttl_seconds": 3600,
        "mask_fields": ["ssn", "bank_account"]
      }
    },
    {
      "id": "support-reads-pii-masked",
      "effect": "allow",
      "resources": ["customer-pii"],
      "when": {
        "min_auth": "mfa",
        "managed_device": true,
        "roles": ["support"],
        "networks": ["corp", "vpn"]
      },
      "obligations": {
        "read_only": true,
        "session_ttl_seconds": 1800,
        "mask_fields": ["ssn", "bank_account", "date_of_birth"]
      }
    },
    {
      "id": "wiki-any-authenticated",
      "effect": "allow",
      "resources": ["wiki"],
      "when": { "min_auth": "password" }
    }
  ]
}
